# 外部环境变量优先级高于本文件中的同名变量。
# 复制为 .env 后可按需修改；真实 .env 不应提交到仓库。

NODE_PORT=2222
NODE_TLS_CLIENT_AUTH=none
INTERNAL_REST_PORT=61001
REQUIRE_SECRET_KEY=true
RW_NODE_DIR=
XRAY_LOCATION_ASSET=
HTTP_FRONT_PORT=3000
XHTTP_UPSTREAM_PORT=8080
WS_UPSTREAM_PORT=8880

# Inbound watcher 开关；设为 false 禁用动态分流（默认 true）。
INBOUND_WATCHER_ENABLED=true

# Inbound watcher 轮询间隔（秒）。
INBOUND_WATCHER_INTERVAL=15

# ── SSH 入口（复用 HTTP_FRONT_PORT，可选）──
# Caddy 按连接首字节识别 SSH（`SSH-`）并转发给内置 sshd-lite，与 HTTP/TLS 共用同一个端口，
# 客户端直接 `ssh -p <HTTP_FRONT_PORT> <user>@<host>` 即可登录。
# 用户名随意填写：sshd-lite 不查系统用户库，容器以 /etc/passwd 中不存在的虚拟 uid 运行时
# 同样能登录（这正是 OpenSSH sshd 与 dropbear 做不到的场景）。
# 只有同时提供公钥才会启用；sshd-lite 缺失或启动失败时自动关闭并告警。
# SSH_ENABLED=true
# SSH_PORT=22222
# SSH_AUTHORIZED_KEYS=ssh-ed25519 AAAAC3Nza... user@example
# 平台限制环境变量长度时可分片，按序号顺序拼接：
# SSH_AUTHORIZED_KEYS_1=<前半段>
# SSH_AUTHORIZED_KEYS_2=<后半段>
# 固定 host key，避免重启后客户端报 host key 变化：
# SSH_HOST_KEY=
# 可选：指定已有 sshd-lite 路径；设置后不会下载。
# SSHD_LITE_BIN=

# 可选：指定 rw-node-go release tag；留空时使用 GitHub latest release。
RW_NODE_GO_VERSION=

# 可选：指定已有 Caddy 二进制路径；设置后不会下载 Caddy。
CADDY_BIN=

# 可选：Cloudflare Tunnel token；非空时自动启动 cloudflared。
ARGO_TOKEN=

# 可选：cloudflared 日志等级；透传给 cloudflared --loglevel。
ARGO_LOG_LEVEL=info

# 可选：指定已有 cloudflared 二进制路径；设置后不会下载 cloudflared。
CLOUDFLARED_BIN=

# 可选：指定 cloudflared release tag；留空时使用 GitHub latest release。
CLOUDFLARED_VERSION=
