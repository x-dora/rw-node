### VITALS ###
NODE_PORT=2222
SECRET_KEY=
# 如果平台限制环境变量长度，可拆分为多个分片：
# SECRET_KEY_1=<前半段>
# SECRET_KEY_2=<后半段>
# SECRET_KEY_3=<更多分片（如需要）>

### Internal (local) ports ###
INTERNAL_REST_PORT=61001

### Runtime ###
REQUIRE_SECRET_KEY=true
NODE_TLS_CLIENT_AUTH=mtls
XRAY_LOCATION_ASSET=/opt/rw-node/share/xray
# SNI_VERIFICATION=false
# GEOCHECK_BINARY_PATH=/opt/rw-node/bin/geocheck

### HTTP Front (Caddy Layer 4, optional) ###
# HTTP_FRONT_ENABLED=false
# HTTP_FRONT_PORT=3000
# XHTTP_UPSTREAM_PORT=8080
# WS_UPSTREAM_PORT=8880
# CADDY_INDEX_PAGE=mikutap
# INBOUND_WATCHER_ENABLED=true
# INBOUND_WATCHER_INTERVAL=15

### SSH entry (HTTP_FRONT_PORT reuse, optional) ###
# Caddy 按连接首字节识别 SSH（`SSH-`）并转发给内置 sshd-lite，与 HTTP/TLS 共用同一个端口。
# 只有同时提供公钥才会启用；sshd-lite 缺失或启动失败时自动关闭。
# 登录用户名随意填写——sshd-lite 不查系统用户库，容器以 /etc/passwd 中不存在的虚拟 uid
# 运行时同样能登录：ssh -p <HTTP_FRONT_PORT> root@<host>
# SSH_ENABLED=true
# SSH_PORT=22222
# SSH_AUTHORIZED_KEYS=ssh-ed25519 AAAAC3Nza... user@example
# 平台限制环境变量长度时可分片，按序号顺序拼接：
# SSH_AUTHORIZED_KEYS_1=<前半段>
# SSH_AUTHORIZED_KEYS_2=<后半段>
# 固定 host key，避免容器重启后客户端报 host key 变化：
# SSH_HOST_KEY=
# 可选：指定已有 sshd-lite 二进制路径；设置后不会下载。
# SSHD_LITE_BIN=

### Memory tuning (Go runtime) ###
# GOGC=50
# GOMEMLIMIT=128MiB
